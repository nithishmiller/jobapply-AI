{
    "name": "JobApply AI — Real Job Search",
    "short_name": "JobApply AI",
    "description": "AI-powered job search: live jobs from real boards, CV matching, application tracking. Installable on Windows, Android and iOS.",
    "id": "jobapply-ai",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "orientation": "any",
    "background_color": "#faf6ee",
    "theme_color": "#faf6ee",
    "lang": "en",
    "categories": ["business", "productivity"],
    "icons": [
        { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        {
            "name": "Job matches",
            "short_name": "Jobs",
            "url": "/?section=jobs",
            "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Applications",
            "short_name": "Pipeline",
            "url": "/?section=applications",
            "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
        }
    ]
}
